{
  // 仅使用 D1。部署脚本先确认数据库 ID，再迁移与发布，无需开通 R2。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vodplus-sync",
  // 只允许自定义域访问：关闭 workers.dev 子域与预览地址
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "vodplus-sync", "migrations_dir": "migrations" }],
  "observability": { "enabled": false },
  "triggers": { "crons": ["17 3 * * *"] }
}
